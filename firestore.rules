rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function userRole(uid, role) { return signedIn() && get(/databases/$(database)/documents/users/$(uid)).data.role == role; }
    function ownsClass(classId) { return signedIn() && get(/databases/$(database)/documents/classes/$(classId)).data.crUid == request.auth.uid; }
    match /users/{uid} {
      allow read: if isUser(uid) || (signedIn() && resource.data.role == 'cr');
      allow create: if isUser(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.profileCompleted == true && request.resource.data.role in ['cr','teacher','student'];
      allow update: if isUser(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /classes/{classId} {
      allow read: if signedIn() && (resource.data.crUid == request.auth.uid);
      allow create: if userRole(request.auth.uid, 'cr') && request.resource.data.crUid == request.auth.uid;
      allow update, delete: if ownsClass(classId);
    }
    match /subjects/{subjectId} {
      allow read: if signedIn() && (ownsClass(resource.data.classId) || resource.data.teacherUid == request.auth.uid);
      allow create: if signedIn() && ownsClass(request.resource.data.classId);
      allow update, delete: if signedIn() && ownsClass(resource.data.classId);
    }
    match /teacherRequests/{requestId} {
      allow create: if userRole(request.auth.uid, 'teacher') && request.resource.data.teacherUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid || ownsClass(resource.data.classId));
      allow update: if ownsClass(resource.data.classId);
      allow delete: if false;
    }
    match /studentRequests/{requestId} {
      allow create: if userRole(request.auth.uid, 'student') && request.resource.data.studentUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || ownsClass(resource.data.classId));
      allow update: if ownsClass(resource.data.classId);
      allow delete: if false;
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownsClass(resource.data.classId));
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
