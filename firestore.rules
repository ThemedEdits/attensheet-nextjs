rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userRole(uid, role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(uid)).data.role == role;
    }
    function ownsClass(classId) {
      return signedIn() && (
        get(/databases/$(database)/documents/classes/$(classId)).data.crUid == request.auth.uid ||
        get(/databases/$(database)/documents/classes/$(classId)).data.secondaryCrUid == request.auth.uid
      );
    }
    function isPrimaryCr(classId) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(classId)).data.crUid == request.auth.uid;
    }
    function memberOf(classId) {
      return signedIn() && get(/databases/$(database)/documents/memberships/$(classId + '_' + request.auth.uid)).data.status == 'approved';
    }

    // Users collection
    match /users/{uid} {
      allow read: if isUser(uid) || (signedIn() && resource.data.role == 'cr');
      allow create: if isUser(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.profileCompleted == true && request.resource.data.role in ['cr', 'teacher', 'student'];
      allow update: if isUser(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Classes collection
    match /classes/{classId} {
      allow read: if signedIn() && (resource.data.crUid == request.auth.uid || resource.data.secondaryCrUid == request.auth.uid || memberOf(classId));
      allow create: if userRole(request.auth.uid, 'cr') && request.resource.data.crUid == request.auth.uid;
      allow update: if ownsClass(classId);
      allow delete: if isPrimaryCr(classId);
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read: if signedIn() && (ownsClass(resource.data.classId) || memberOf(resource.data.classId) || resource.data.teacherUid == request.auth.uid);
      allow create: if signedIn() && ownsClass(request.resource.data.classId);
      allow update, delete: if signedIn() && ownsClass(request.resource.data.classId);
    }

    // Teacher Requests
    match /teacherRequests/{requestId} {
      allow create: if userRole(request.auth.uid, 'teacher') && request.resource.data.teacherUid == request.auth.uid
        && !exists(/databases/$(database)/documents/memberships/$(request.resource.data.classId + '_' + request.auth.uid));
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid || ownsClass(resource.data.classId));
      allow update: if ownsClass(resource.data.classId);
      allow delete: if false;
    }

    // Student Requests
    match /studentRequests/{requestId} {
      allow create: if userRole(request.auth.uid, 'student') && request.resource.data.studentUid == request.auth.uid
        && !exists(/databases/$(database)/documents/memberships/$(request.resource.data.classId + '_' + request.auth.uid));
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || ownsClass(resource.data.classId));
      allow update: if ownsClass(resource.data.classId);
      allow delete: if false;
    }

    // Memberships collection
    match /memberships/{membershipId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownsClass(resource.data.classId));
      allow create: if signedIn() && ownsClass(request.resource.data.classId) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        ownsClass(resource.data.classId) ||
        (memberOf(resource.data.classId) && get(/databases/$(database)/documents/memberships/$(resource.data.classId + '_' + request.auth.uid)).data.role == 'teacher')
      );
      allow write: if false;
    }

    // Sensitive server-only collections
    match /googleTokens/{uid} {
      allow read, write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
